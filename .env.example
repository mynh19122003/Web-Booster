# Future server-only backend URL; no Admin API integration is active.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
# API mode is the only supported runtime source.
NEXT_PUBLIC_PUBLIC_DATA_SOURCE=api
# Public browser origin accepted by the Socket.IO server behind a reverse proxy.
# CHAT_ORIGIN=https://your-domain.example
# Both chat frontends must connect to this same Socket.IO endpoint in production.
# NEXT_PUBLIC_CHAT_SOCKET_URL=https://chat.your-domain.example
# CHAT_ALLOWED_ORIGINS=https://your-domain.example,https://employee.your-domain.example
# Explicit UI review sources. api selects a controlled unimplemented adapter.
NEXT_PUBLIC_ADMIN_AUTH_SOURCE=api
NEXT_PUBLIC_ADMIN_STAFF_SOURCE=api
NEXT_PUBLIC_ADMIN_DASHBOARD_SOURCE=api
NEXT_PUBLIC_ADMIN_ORDERS_SOURCE=api
NEXT_PUBLIC_ADMIN_ASSIGNMENTS_SOURCE=api
NEXT_PUBLIC_ADMIN_CHAT_SOURCE=api
NEXT_PUBLIC_ADMIN_SECURITY_SOURCE=api
NEXT_PUBLIC_ADMIN_NOTIFICATIONS_SOURCE=api
# Optional hosted launcher release URL. Otherwise ship the setup in public/downloads/.
# NEXT_PUBLIC_ASCEND_LAUNCHER_DOWNLOAD_URL=https://your-release-host/AscendLauncher_0.1.0_x64-setup.exe
